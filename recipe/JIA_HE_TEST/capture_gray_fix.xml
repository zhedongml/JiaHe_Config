<?xml version="1.0"?>
<root main_tree_to_execute="BehaviorTree">
 <BehaviorTree ID="BehaviorTree">
  <!-- Add nodes here -->
  <Sequence name="Sequence">
   <!-- System Init -->
   <Action name="System_Date" ID="System_Date" date_key="cur_data"/>
   <Action name="System_DateTime" ID="System_DateTime" date_time_key="cur_datatime"/>
   <!--Devices Connect-->
   <Parallel name="Parallel">
    <Action name="AA_Connect_MeasureCameraMotionModule" ID="AA_Connect_MeasureCameraMotionModule"/>
    <Action name="AA_Connect_ProjectorMotionModule" ID="AA_Connect_ProjectorMotionModule"/>
    <Action name="AA_Connect_DutMotionModule" ID="AA_Connect_DutMotionModule"/>
   </Parallel>
   <!-- SLB Alignment Init-->
   <Action name="IQ_SetDutID" ID="IQ_SetDutID" id_key="dutid" id_value="SLB"/>
   <Action name="IQ_SetTestState" ID="IQ_SetTestState" is_dut="0" is_update_slb="1" size="" size_key=""/>
   <Action name="SetBlackboard" ID="SetBlackboard" output_key="aperture" value="3"/>
   <!--Alignment SLB & IQ IS Devices Connect & Calibration Data Load-->
   <Parallel name="Parallel">
    <Sequence name="Sequence">
     <Action name="Colorimeter_Connect_All_Async" ID="Colorimeter_Connect_All_Async"/>
     <Action name="Colorimeter_Camera_StopGrabbing" ID="Colorimeter_Camera_StopGrabbing"/>
     <Action name="Colorimeter_Camera_SetBinningSelector" ID="Colorimeter_Camera_SetBinningSelector" binning_selector="Logic"/>
     <Action name="Colorimeter_Camera_SetBinningMode" ID="Colorimeter_Camera_SetBinningMode" binning_mode="Average"/>
    </Sequence>
    <Action name="Colorimeter_LoadCalibrationData" ID="Colorimeter_LoadCalibrationData" aperture="{aperture}" binning="1" colorfilter_list="X,Y,Z,Clear" ndfliter_list="ND0" lightsource_list="R,G,B,W" is_load_dark="1" is_load_colorshift="1" is_load_ffc="1" is_load_distortion="1" is_load_exposure="1" is_load_fliprotation="1" is_load_luminance="0" is_load_fourcolor="0"/>
   </Parallel>
   <!-- IQ Init-->
   <Action name="SetBlackboard" ID="SetBlackboard" output_key="ISphere_scale_R" value="0.96"/>
   <Action name="SetBlackboard" ID="SetBlackboard" output_key="ISphere_scale_G" value="0.96"/>
   <Action name="SetBlackboard" ID="SetBlackboard" output_key="ISphere_scale_B" value="0.96"/>
   <Action name="SetBlackboard" ID="SetBlackboard" output_key="nd_select" value="ND0"/>
   <Action name="SetBlackboard" ID="SetBlackboard" output_key="xyzc_select" value="Clear"/>
   <Action name="SetBlackboard" ID="SetBlackboard" output_key="is_auto_exposure" value=""/>
   <Action name="SetBlackboard" ID="SetBlackboard" output_key="exposure_init_time" value=""/>
   <Action name="SetBlackboard" ID="SetBlackboard" output_key="binning_4" value="4"/>
   <Action name="SetBlackboard" ID="SetBlackboard" output_key="binning_1" value="1"/>
   <Action name="IQ_SetEyeboxList" ID="IQ_SetEyeboxList" eyeboxlist="5" key="eyeboxids"/>
   <Action name="IQ_Metrics_CreateDBTable" ID="IQ_Metrics_CreateDBTable"/>
   <Action name="IQ_Metrics_CreateResultFile" ID="IQ_Metrics_CreateResultFile" root_dir="E:\SAT_GRR\{cur_data}_MetricsTest" dut_seq="{dutid}_{cur_datatime}" csvname="SLB_{cur_datatime}_metrics" all_csvname="SLB_metrics_all"/>
   <!-- capture image -->
   <Action name="IQ_LoadFixExposureTime" ID="IQ_LoadFixExposureTime" is_match_eb="0"/>
   <For name="For" traverse_params="{eyeboxids}">
    <Sequence name="Sequence">
     <Action name="System_GetForNodeValue1" ID="System_GetForNodeValue1" value_key="cur_eb"/>
     <For name="For" traverse_params="R,G,B;{ISphere_scale_R},{ISphere_scale_G},{ISphere_scale_B}">
      <Sequence name="Sequence">
       <Action name="System_GetForNodeValue2" ID="System_GetForNodeValue2" value_key1="color" value_key2="isphere_scale"/>
       <!-- solid pattern (R&G&B) -->
       <!-- <Action name="Colorimeter_Capture_LuminanceImage_Async" ID="Colorimeter_Capture_LuminanceImage_Async" aperture="{aperture}" dutid="{dutid}" eyeboxid="{cur_eb}" binning="{binning_4}" nd_filter="{nd_select}" color_filter="X" light_source="{color}" image_type="solid" is_auto_et="{is_auto_exposure}" exposure_time="{exposure_init_time}" et_factor="1" is_convert_16bit="0" convert_method="0" save_raw_image="1" save_calibration_image="0" is_hdr="0" max_exposure_time="" nameRule="#LightSource#_#Pattern#_#EyeboxID#_#ColorFilter#_#NDFilter#"/> -->
       <!-- <Action name="Colorimeter_Capture_LuminanceImage_Async" ID="Colorimeter_Capture_LuminanceImage_Async" aperture="{aperture}" dutid="{dutid}" eyeboxid="{cur_eb}" binning="{binning_4}" nd_filter="{nd_select}" color_filter="Y" light_source="{color}" image_type="solid" is_auto_et="{is_auto_exposure}" exposure_time="{exposure_init_time}" et_factor="1" is_convert_16bit="0" convert_method="0" save_raw_image="1" save_calibration_image="0" is_hdr="0" max_exposure_time="" nameRule="#LightSource#_#Pattern#_#EyeboxID#_#ColorFilter#_#NDFilter#"/> -->
       <!-- <Action name="Colorimeter_Capture_LuminanceImage_Async" ID="Colorimeter_Capture_LuminanceImage_Async" aperture="{aperture}" dutid="{dutid}" eyeboxid="{cur_eb}" binning="{binning_4}" nd_filter="{nd_select}" color_filter="Z" light_source="{color}" image_type="solid" is_auto_et="{is_auto_exposure}" exposure_time="{exposure_init_time}" et_factor="1" is_convert_16bit="0" convert_method="0" save_raw_image="1" save_calibration_image="0" is_hdr="0" max_exposure_time="" nameRule="#LightSource#_#Pattern#_#EyeboxID#_#ColorFilter#_#NDFilter#"/> -->
       <!-- 0.5 Checker Pattern (R&G&B) -->
       <Action name="Colorimeter_Capture_GrayImage_Async" ID="Colorimeter_Capture_GrayImage_Async" aperture="{aperture}" dutid="{dutid}" eyeboxid="{cur_eb}" binning="{binning_4}" nd_filter="{nd_select}" color_filter="{xyzc_select}" light_source="{color}" image_type="0.5deg_Checker" is_auto_et="{is_auto_exposure}" exposure_time="{exposure_init_time}" et_factor="" is_convert_16bit="0" convert_method="0" save_raw_image="1" save_calibration_image="0" is_hdr="0" max_exposure_time="" nameRule="#LightSource#_#Pattern#_#EyeboxID#_#ColorFilter#_#NDFilter#"/>
       <!-- 2 Checker Pattern (R&G&B) -->
       <Action name="Colorimeter_Capture_GrayImage_Async" ID="Colorimeter_Capture_GrayImage_Async" aperture="{aperture}" dutid="{dutid}" eyeboxid="{cur_eb}" binning="{binning_4}" nd_filter="{nd_select}" color_filter="{xyzc_select}" light_source="{color}" image_type="2deg_Checker" is_auto_et="{is_auto_exposure}" exposure_time="{exposure_init_time}" et_factor="" is_convert_16bit="0" convert_method="0" save_raw_image="1" save_calibration_image="0" is_hdr="0" max_exposure_time="" nameRule="#LightSource#_#Pattern#_#EyeboxID#_#ColorFilter#_#NDFilter#"/>
       <!-- slanted edge Pattern (R&G&B) -->
       <Action name="Colorimeter_Capture_GrayImage_Async" ID="Colorimeter_Capture_GrayImage_Async" aperture="{aperture}" dutid="{dutid}" eyeboxid="{cur_eb}" binning="{binning_1}" nd_filter="{nd_select}" color_filter="{xyzc_select}" light_source="{color}" image_type="slantedEdge" is_auto_et="{is_auto_exposure}" exposure_time="{exposure_init_time}" et_factor="" is_convert_16bit="0" convert_method="0" save_raw_image="1" save_calibration_image="0" is_hdr="0" max_exposure_time="" nameRule="#LightSource#_#Pattern#_#EyeboxID#_#ColorFilter#_#NDFilter#"/>
       <!-- grid Pattern (R&G&B) -->
       <Action name="Colorimeter_Capture_GrayImage_Async" ID="Colorimeter_Capture_GrayImage_Async" aperture="{aperture}" dutid="{dutid}" eyeboxid="{cur_eb}" binning="{binning_1}" nd_filter="{nd_select}" color_filter="{xyzc_select}" light_source="{color}" image_type="grid" is_auto_et="{is_auto_exposure}" exposure_time="{exposure_init_time}" et_factor="" is_convert_16bit="0" convert_method="0" save_raw_image="1" save_calibration_image="0" is_hdr="0" max_exposure_time="" nameRule="#LightSource#_#Pattern#_#EyeboxID#_#ColorFilter#_#NDFilter#"/>
      </Sequence>
     </For>
    </Sequence>
   </For>
  </Sequence>
 </BehaviorTree>
</root>
